# Lucky Sun Shine — environment variables
#
# Copy to `.env.local` for local development. Next.js reads `.env.local`
# automatically; do NOT commit `.env.local` (it is gitignored).
#
# In production (GitHub Actions), set these as repository Variables:
#   Settings → Secrets and variables → Actions → Variables
# The build workflow (.github/workflows/deploy-pages.yml) injects them
# into `npm run build` from `${{ vars.* }}`.
#
# All NEXT_PUBLIC_* values are inlined at build time and visible in the
# shipped JS bundle — never put secrets here.

# Canonical site URL (used in metadata, sitemap, RSS, schema)
NEXT_PUBLIC_SITE_URL=https://lucky-sun-shine.com

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Contact form (Formspree project ID)
NEXT_PUBLIC_FORMSPREE_ID=

# AdSense
NEXT_PUBLIC_ADSENSE_CLIENT=

# Amazon Associate tag — appended as `?tag=<value>` on all Amazon links.
NEXT_PUBLIC_AMAZON_TAG=luckysunshine-22

# 楽天アフィリエイトID — appended as `?scid=af_<value>` on all 楽天 links.
NEXT_PUBLIC_RAKUTEN_AFB=208f8a99

# もしもアフィリエイト a_id (optional reference value)
NEXT_PUBLIC_MOSHIMO_AID=
